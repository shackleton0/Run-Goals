rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'eskin.adam@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function teacherPath() {
      return /databases/$(database)/documents/teachers/$(request.auth.token.email.lower());
    }

    function isActiveTeacher() {
      return hasVerifiedEmail()
        && exists(teacherPath())
        && get(teacherPath()).data.status == 'active';
    }

    function myTeacherDoc() {
      return get(teacherPath()).data;
    }

    function isTeamMember(teamCode) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teamCode', '') == teamCode;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function isValidInviteCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 16 && code.matches('^[A-Z0-9]+$');
    }

    function isValidTeacherId(id) {
      return id is string && id.size() >= 3 && id.size() <= 254 && id.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function isValidAdminConfig(data) {
      return data.keys().hasAll(['id', 'pinHash', 'pinSalt'])
        && data.keys().hasOnly(['id', 'pinHash', 'pinSalt', 'pinLength', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.pinHash is string && data.pinHash.size() == 64 && data.pinHash.matches('^[a-f0-9]+$')
        && data.pinSalt is string && data.pinSalt.size() >= 16 && data.pinSalt.size() <= 64
        && (!('pinLength' in data) || (data.pinLength is number && data.pinLength >= 4 && data.pinLength <= 8))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('targetDistanceKm' in data) || (data.targetDistanceKm is number && data.targetDistanceKm > 0 && data.targetDistanceKm <= 100))
        && (!('targetGoalName' in data) || (data.targetGoalName is string && data.targetGoalName.size() <= 128))
        && (!('targetTimeSeconds' in data) || (data.targetTimeSeconds is number && data.targetTimeSeconds > 0))
        && (!('targetPaceSecPerKm' in data) || (data.targetPaceSecPerKm is number && data.targetPaceSecPerKm > 0))
        && (!('target6kTimeSeconds' in data) || (data.target6kTimeSeconds is number && data.target6kTimeSeconds > 0))
        && (!('hasCustomTarget' in data) || (data.hasCustomTarget is bool))
        && (!('current6kPrSeconds' in data) || (data.current6kPrSeconds is number && data.current6kPrSeconds > 0))
        && data.weeklyRunGoal is number && data.weeklyRunGoal >= 1 && data.weeklyRunGoal <= 14
        && (!('weeklyDistanceGoalKm' in data) || (data.weeklyDistanceGoalKm is number && data.weeklyDistanceGoalKm >= 0 && data.weeklyDistanceGoalKm <= 500))
        && (!('unitPreference' in data) || (data.unitPreference in ['km', 'miles']))
        && (!('athleteLevel' in data) || (data.athleteLevel in ['Beginner', 'High School XC', 'Collegiate / Advanced', 'Masters']))
        && (!('yraaDivision' in data) || (data.yraaDivision in ['novice_women', 'novice_men', 'para_men', 'junior_women', 'junior_men', 'senior_women', 'senior_men']))
        && (!('maxHeartRate' in data) || (data.maxHeartRate is number && data.maxHeartRate >= 100 && data.maxHeartRate <= 250))
        && (!('defaultIntervalPaceSecPerKm' in data) || (data.defaultIntervalPaceSecPerKm is number && data.defaultIntervalPaceSecPerKm > 0))
        && (!('defaultRepDistanceMeters' in data) || (data.defaultRepDistanceMeters is number && data.defaultRepDistanceMeters > 0))
        && (!('defaultRestDurationSeconds' in data) || (data.defaultRestDurationSeconds is number && data.defaultRestDurationSeconds >= 0))
        && (!('defaultRepCount' in data) || (data.defaultRepCount is number && data.defaultRepCount > 0))
        && (!('goalTimeframeWeeks' in data) || (data.goalTimeframeWeeks is number && data.goalTimeframeWeeks >= 1 && data.goalTimeframeWeeks <= 104))
        && (!('targetGoalDate' in data) || (data.targetGoalDate is string && data.targetGoalDate.size() <= 32))
        && (!('onboardingCompleted' in data) || (data.onboardingCompleted is bool))
        && (!('accountStatus' in data) || (data.accountStatus in ['active', 'suspended']))
        && (!('suspensionReason' in data) || (data.suspensionReason is string && data.suspensionReason.size() <= 300))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000))
        && (!('coachNotes' in data) || (data.coachNotes is string && data.coachNotes.size() <= 1000))
        && (!('teamCode' in data) || isValidInviteCode(data.teamCode))
        && (!('teamName' in data) || (data.teamName is string && data.teamName.size() <= 120))
        && (!('coachName' in data) || (data.coachName is string && data.coachName.size() <= 128))
        && (!('joinedTeamAt' in data) || (data.joinedTeamAt is string && data.joinedTeamAt.size() <= 64))
        && (!('directMessageTitle' in data) || (data.directMessageTitle is string && data.directMessageTitle.size() <= 120))
        && (!('directMessageBody' in data) || (data.directMessageBody is string && data.directMessageBody.size() <= 1000))
        && (!('directMessageSeverity' in data) || (data.directMessageSeverity in ['info', 'warning', 'success']))
        && (!('directMessageSentAt' in data) || (data.directMessageSentAt is string && data.directMessageSentAt.size() <= 64))
        && (!('directMessageReadAt' in data) || (data.directMessageReadAt is string && data.directMessageReadAt.size() <= 64))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidRunRecord(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && (!('teamCode' in data) || isValidInviteCode(data.teamCode))
        && data.date is string && data.date.size() <= 32
        && data.title is string && data.title.size() <= 150
        && data.distanceKm is number && data.distanceKm >= 0
        && data.durationSeconds is number && data.durationSeconds >= 0
        && (!('averagePaceSecPerKm' in data) || (data.averagePaceSecPerKm is number))
        && (!('best6kTimeSeconds' in data) || (data.best6kTimeSeconds is number))
        && (!('targetEquivalentSeconds' in data) || (data.targetEquivalentSeconds is number))
        && data.runType in ['Aerobic', 'Interval Training', '6K Time Trial', 'Time Trial', 'Tempo', 'Long Run', 'Race', 'Easy', 'Intervals', 'Recovery', 'Hill Repeats', 'Hill Run']
        && (!('slotId' in data) || (data.slotId is string && data.slotId.size() <= 32))
        && (!('avgHeartRate' in data) || (data.avgHeartRate is number))
        && (!('maxHeartRate' in data) || (data.maxHeartRate is number))
        && (!('avgCadence' in data) || (data.avgCadence is number))
        && (!('elevationGainMeters' in data) || (data.elevationGainMeters is number))
        && (!('source' in data) || (data.source is string && data.source.size() <= 64))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('garminActivityId' in data) || (data.garminActivityId is string && data.garminActivityId.size() <= 128))
        && (!('targetIntervalPaceSecPerKm' in data) || (data.targetIntervalPaceSecPerKm is number))
        && (!('activeIntervalPaceSecPerKm' in data) || (data.activeIntervalPaceSecPerKm is number))
        && (!('repCount' in data) || (data.repCount is number))
        && (!('repDistanceMeters' in data) || (data.repDistanceMeters is number))
        && (!('restDurationSeconds' in data) || (data.restDurationSeconds is number))
        && (!('totalRestSeconds' in data) || (data.totalRestSeconds is number))
        && (!('intervalDetails' in data) || (data.intervalDetails is map))
        && (!('plannedWorkoutId' in data) || (data.plannedWorkoutId is string && data.plannedWorkoutId.size() <= 128))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTeamWorkout(data) {
      return data.keys().hasAll([
          'id', 'teamCode', 'coachEmail', 'date', 'title', 'runType',
          'distanceKm', 'durationSeconds', 'completedUserIds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'teamCode', 'coachEmail', 'date', 'title', 'runType',
          'distanceKm', 'durationSeconds', 'targetPaceHint', 'notes',
          'completedUserIds', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidInviteCode(data.teamCode)
        && data.coachEmail is string && data.coachEmail.size() <= 256
        && data.date is string && data.date.size() <= 32
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.runType in ['Aerobic', 'Interval Training', '6K Time Trial', 'Time Trial', 'Tempo', 'Long Run', 'Race', 'Easy', 'Intervals', 'Recovery', 'Hill Repeats', 'Hill Run']
        && data.distanceKm is number && data.distanceKm > 0 && data.distanceKm <= 500
        && data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400
        && (!('targetPaceHint' in data) || (data.targetPaceHint is string && data.targetPaceHint.size() <= 80))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && data.completedUserIds is list
        && data.completedUserIds.size() <= 500
        && (data.completedUserIds.size() == 0 || data.completedUserIds[0] is string)
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidTeacherRecord(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'teamName', 'inviteCode', 'status', 'addedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'teamName', 'inviteCode', 'status', 'addedBy', 'createdAt', 'updatedAt'])
        && isValidTeacherId(data.id)
        && isValidTeacherId(data.email)
        && data.displayName is string && data.displayName.size() <= 128
        && data.teamName is string && data.teamName.size() <= 120
        && isValidInviteCode(data.inviteCode)
        && data.status in ['active', 'suspended']
        && data.addedBy is string && data.addedBy.size() <= 256
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidTeamInvite(data) {
      return data.keys().hasAll(['id', 'teamName', 'coachName', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id',
          'teamName',
          'coachName',
          'active',
          'teamAnnouncementTitle',
          'teamAnnouncementMessage',
          'teamAnnouncementSeverity',
          'teamAnnouncementUpdatedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidInviteCode(data.id)
        && data.teamName is string && data.teamName.size() <= 120
        && data.coachName is string && data.coachName.size() <= 128
        && data.active is bool
        && (!('teamAnnouncementTitle' in data) || (data.teamAnnouncementTitle is string && data.teamAnnouncementTitle.size() <= 120))
        && (!('teamAnnouncementMessage' in data) || (data.teamAnnouncementMessage is string && data.teamAnnouncementMessage.size() <= 500))
        && (!('teamAnnouncementSeverity' in data) || (data.teamAnnouncementSeverity in ['info', 'warning', 'success']))
        && (!('teamAnnouncementUpdatedAt' in data) || (data.teamAnnouncementUpdatedAt is string && data.teamAnnouncementUpdatedAt.size() <= 64))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidAppAnnouncement(data) {
      return data.keys().hasAll(['id', 'enabled', 'title', 'message', 'severity', 'updatedAt'])
        && data.keys().hasOnly(['id', 'enabled', 'title', 'message', 'severity', 'updatedAt', 'updatedBy'])
        && data.id == 'announcement'
        && data.enabled is bool
        && data.title is string && data.title.size() <= 120
        && data.message is string && data.message.size() <= 500
        && data.severity in ['info', 'warning', 'success']
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 256));
    }

    function isValidAdminLog(data) {
      return data.keys().hasAll(['id', 'adminUid', 'adminEmail', 'action', 'details', 'createdAt'])
        && data.keys().hasOnly(['id', 'adminUid', 'adminEmail', 'action', 'targetId', 'targetLabel', 'details', 'createdAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.adminUid is string && data.adminUid == request.auth.uid
        && data.adminEmail is string && data.adminEmail.size() <= 256
        && data.action in [
          'delete_user',
          'suspend_user',
          'restore_user',
          'edit_user',
          'reset_user_runs',
          'reset_onboarding',
          'add_run',
          'edit_run',
          'delete_run',
          'purge_orphan_runs',
          'update_announcement',
          'send_user_message',
          'clear_user_message',
          'add_teacher',
          'edit_teacher',
          'suspend_teacher',
          'restore_teacher',
          'delete_teacher',
          'rotate_teacher_code',
          'change_pin'
        ]
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128))
        && (!('targetLabel' in data) || (data.targetLabel is string && data.targetLabel.size() <= 256))
        && data.details is string && data.details.size() <= 500
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // User Profile: /users/{userId}
    match /users/{userId} {
      allow get: if isValidId(userId) && (
        isAdmin()
        || (isSignedIn() && request.auth.uid == userId)
        || (isActiveTeacher() && existing().get('teamCode', '') == myTeacherDoc().inviteCode)
      );
      allow list: if isAdmin()
        || (isActiveTeacher() && resource.data.teamCode == myTeacherDoc().inviteCode);
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().id == userId
        && isValidUserProfile(incoming())
        && (!('accountStatus' in incoming()) || incoming().accountStatus == 'active')
        && !('suspensionReason' in incoming())
        && !('adminNotes' in incoming())
        && !('coachNotes' in incoming())
        && !('teamCode' in incoming())
        && !('teamName' in incoming())
        && !('coachName' in incoming())
        && !('joinedTeamAt' in incoming())
        && !('directMessageTitle' in incoming())
        && !('directMessageBody' in incoming())
        && !('directMessageSeverity' in incoming())
        && !('directMessageSentAt' in incoming())
        && !('directMessageReadAt' in incoming());
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == existing().id
        && (
          isAdmin()
          || (
            isActiveTeacher()
            && existing().get('teamCode', '') == myTeacherDoc().inviteCode
            && incoming().email == existing().email
            && incoming().get('adminNotes', '') == existing().get('adminNotes', '')
            && (
              (!('teamCode' in incoming()) && !('teamName' in incoming()) && !('coachName' in incoming()) && !('joinedTeamAt' in incoming()))
              || (
                incoming().get('teamCode', '') == existing().get('teamCode', '')
                && incoming().get('teamName', '') == existing().get('teamName', '')
                && incoming().get('coachName', '') == existing().get('coachName', '')
                && incoming().get('joinedTeamAt', '') == existing().get('joinedTeamAt', '')
              )
            )
          )
          || (
            isSignedIn()
            && request.auth.uid == userId
            && (!('accountStatus' in existing()) || existing().accountStatus != 'suspended')
            && !incoming().diff(existing()).affectedKeys().hasAny([
              'accountStatus',
              'suspensionReason',
              'adminNotes',
              'coachNotes',
              'directMessageTitle',
              'directMessageBody',
              'directMessageSeverity',
              'directMessageSentAt'
            ])
            && (
              !incoming().diff(existing()).affectedKeys().hasAny(['teamCode', 'teamName', 'coachName', 'joinedTeamAt'])
              || (!('teamCode' in incoming()) && !('teamName' in incoming()) && !('coachName' in incoming()) && !('joinedTeamAt' in incoming()))
              || (
                'teamCode' in incoming()
                && isValidInviteCode(incoming().teamCode)
                && exists(/databases/$(database)/documents/teamInvites/$(incoming().teamCode))
                && get(/databases/$(database)/documents/teamInvites/$(incoming().teamCode)).data.active == true
              )
            )
          )
        );
      allow delete: if isValidId(userId)
        && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
    }

    // Runs Collection: /runs/{runId}
    match /runs/{runId} {
      allow get: if isValidId(runId) && (
        isAdmin()
        || (isSignedIn() && existing().userId == request.auth.uid)
        || (isActiveTeacher() && existing().get('teamCode', '') == myTeacherDoc().inviteCode)
      );
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isActiveTeacher() && resource.data.teamCode == myTeacherDoc().inviteCode);
      allow create: if isValidId(runId)
        && incoming().id == runId
        && isValidRunRecord(incoming())
        && (
          isAdmin()
          || (
            isSignedIn()
            && incoming().userId == request.auth.uid
            && (
              !('teamCode' in incoming())
              || (
                exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teamCode', '') == incoming().teamCode
              )
            )
          )
          || (
            isActiveTeacher()
            && incoming().get('teamCode', '') == myTeacherDoc().inviteCode
            && exists(/databases/$(database)/documents/users/$(incoming().userId))
            && get(/databases/$(database)/documents/users/$(incoming().userId)).data.get('teamCode', '') == myTeacherDoc().inviteCode
          )
        );
      allow update: if isValidId(runId)
        && isValidRunRecord(incoming())
        && incoming().id == existing().id
        && (
          isAdmin()
          || (
            isSignedIn()
            && existing().userId == request.auth.uid
            && incoming().userId == existing().userId
            && (
              !('teamCode' in incoming())
              || (
                exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teamCode', '') == incoming().teamCode
              )
            )
          )
          || (
            isActiveTeacher()
            && existing().get('teamCode', '') == myTeacherDoc().inviteCode
            && incoming().userId == existing().userId
            && (!('teamCode' in incoming()) || incoming().teamCode == existing().teamCode)
          )
        );
      allow delete: if isValidId(runId) && (
        isAdmin()
        || (isSignedIn() && existing().userId == request.auth.uid)
        || (isActiveTeacher() && existing().get('teamCode', '') == myTeacherDoc().inviteCode)
      );
    }

    // Teachers Whitelist: /teachers/{teacherId} (teacherId is lowercase normalized email)
    match /teachers/{teacherId} {
      allow get: if isValidTeacherId(teacherId) && (
        isAdmin()
        || (hasVerifiedEmail() && teacherId == request.auth.token.email.lower())
      );
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidTeacherId(teacherId)
        && incoming().id == teacherId
        && incoming().email == teacherId
        && isValidTeacherRecord(incoming());
      allow update: if isValidTeacherId(teacherId)
        && isValidTeacherRecord(incoming())
        && incoming().id == existing().id
        && incoming().email == existing().email
        && (
          isAdmin()
          || (
            isActiveTeacher()
            && teacherId == request.auth.token.email.lower()
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'teamName', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidTeacherId(teacherId);
    }

    // Public-to-authenticated Team Invites (Zero PII): /teamInvites/{inviteCode}
    match /teamInvites/{inviteCode} {
      allow get: if isSignedIn() && isValidInviteCode(inviteCode);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidInviteCode(inviteCode)
        && incoming().id == inviteCode
        && isValidTeamInvite(incoming());
      allow update: if isValidInviteCode(inviteCode)
        && isValidTeamInvite(incoming())
        && incoming().id == existing().id
        && (
          isAdmin()
          || (
            isActiveTeacher()
            && inviteCode == myTeacherDoc().inviteCode
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'teamName',
              'coachName',
              'active',
              'teamAnnouncementTitle',
              'teamAnnouncementMessage',
              'teamAnnouncementSeverity',
              'teamAnnouncementUpdatedAt',
              'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidInviteCode(inviteCode);
    }

    // Admin Passcode Config: /adminConfig/{userId}
    match /adminConfig/{userId} {
      allow get: if isAdmin() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().id == userId
        && isValidAdminConfig(incoming());
      allow update: if isAdmin()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().id == existing().id
        && isValidAdminConfig(incoming());
      allow delete: if false;
    }

    // Global App Announcement: /appConfig/announcement
    match /appConfig/{configId} {
      allow get: if isValidId(configId) && configId == 'announcement' && isSignedIn();
      allow list: if false;
      allow create, update: if isAdmin()
        && isValidId(configId)
        && configId == 'announcement'
        && isValidAppAnnouncement(incoming());
      allow delete: if isAdmin() && isValidId(configId) && configId == 'announcement';
    }

    // Admin Audit Logs: /adminLogs/{logId}
    match /adminLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(logId)
        && incoming().id == logId
        && isValidAdminLog(incoming());
      allow update: if false;
      allow delete: if isAdmin() && isValidId(logId);
    }

    // Coach Planned Team Workouts: /teamWorkouts/{workoutId}
    match /teamWorkouts/{workoutId} {
      allow get: if isValidId(workoutId) && (
        isAdmin()
        || (isActiveTeacher() && existing().teamCode == myTeacherDoc().inviteCode)
        || isTeamMember(existing().teamCode)
      );
      allow list: if isAdmin()
        || (isActiveTeacher() && resource.data.teamCode == myTeacherDoc().inviteCode)
        || isTeamMember(resource.data.teamCode);
      allow create: if isValidId(workoutId)
        && incoming().id == workoutId
        && isValidTeamWorkout(incoming())
        && (
          isAdmin()
          || (isActiveTeacher() && incoming().teamCode == myTeacherDoc().inviteCode)
        );
      allow update: if isValidId(workoutId)
        && isValidTeamWorkout(incoming())
        && incoming().id == existing().id
        && incoming().teamCode == existing().teamCode
        && (
          isAdmin()
          || (isActiveTeacher() && existing().teamCode == myTeacherDoc().inviteCode)
        );
      allow delete: if isValidId(workoutId) && (
        isAdmin()
        || (isActiveTeacher() && existing().teamCode == myTeacherDoc().inviteCode)
      );
    }
  }
}
