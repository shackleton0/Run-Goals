rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'eskin.adam@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function isValidAdminConfig(data) {
      return data.keys().hasAll(['id', 'pinHash', 'pinSalt'])
        && data.keys().hasOnly(['id', 'pinHash', 'pinSalt', 'pinLength', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.pinHash is string && data.pinHash.size() == 64 && data.pinHash.matches('^[a-f0-9]+$')
        && data.pinSalt is string && data.pinSalt.size() >= 16 && data.pinSalt.size() <= 64
        && (!('pinLength' in data) || (data.pinLength is number && data.pinLength >= 4 && data.pinLength <= 8))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('targetDistanceKm' in data) || (data.targetDistanceKm is number && data.targetDistanceKm > 0 && data.targetDistanceKm <= 100))
        && (!('targetGoalName' in data) || (data.targetGoalName is string && data.targetGoalName.size() <= 128))
        && (!('targetTimeSeconds' in data) || (data.targetTimeSeconds is number && data.targetTimeSeconds > 0))
        && (!('targetPaceSecPerKm' in data) || (data.targetPaceSecPerKm is number && data.targetPaceSecPerKm > 0))
        && (!('target6kTimeSeconds' in data) || (data.target6kTimeSeconds is number && data.target6kTimeSeconds > 0))
        && (!('hasCustomTarget' in data) || (data.hasCustomTarget is bool))
        && (!('current6kPrSeconds' in data) || (data.current6kPrSeconds is number && data.current6kPrSeconds > 0))
        && data.weeklyRunGoal is number && data.weeklyRunGoal >= 1 && data.weeklyRunGoal <= 14
        && (!('weeklyDistanceGoalKm' in data) || (data.weeklyDistanceGoalKm is number && data.weeklyDistanceGoalKm >= 0 && data.weeklyDistanceGoalKm <= 500))
        && (!('unitPreference' in data) || (data.unitPreference in ['km', 'miles']))
        && (!('athleteLevel' in data) || (data.athleteLevel in ['Beginner', 'High School XC', 'Collegiate / Advanced', 'Masters']))
        && (!('yraaDivision' in data) || (data.yraaDivision in ['novice_women', 'novice_men', 'para_men', 'junior_women', 'junior_men', 'senior_women', 'senior_men']))
        && (!('maxHeartRate' in data) || (data.maxHeartRate is number && data.maxHeartRate >= 100 && data.maxHeartRate <= 250))
        && (!('defaultIntervalPaceSecPerKm' in data) || (data.defaultIntervalPaceSecPerKm is number && data.defaultIntervalPaceSecPerKm > 0))
        && (!('defaultRepDistanceMeters' in data) || (data.defaultRepDistanceMeters is number && data.defaultRepDistanceMeters > 0))
        && (!('defaultRestDurationSeconds' in data) || (data.defaultRestDurationSeconds is number && data.defaultRestDurationSeconds >= 0))
        && (!('defaultRepCount' in data) || (data.defaultRepCount is number && data.defaultRepCount > 0))
        && (!('goalTimeframeWeeks' in data) || (data.goalTimeframeWeeks is number && data.goalTimeframeWeeks >= 1 && data.goalTimeframeWeeks <= 104))
        && (!('targetGoalDate' in data) || (data.targetGoalDate is string && data.targetGoalDate.size() <= 32))
        && (!('onboardingCompleted' in data) || (data.onboardingCompleted is bool))
        && (!('accountStatus' in data) || (data.accountStatus in ['active', 'suspended']))
        && (!('suspensionReason' in data) || (data.suspensionReason is string && data.suspensionReason.size() <= 300))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidRunRecord(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.date is string && data.date.size() <= 32
        && data.title is string && data.title.size() <= 150
        && data.distanceKm is number && data.distanceKm >= 0
        && data.durationSeconds is number && data.durationSeconds >= 0
        && (!('averagePaceSecPerKm' in data) || (data.averagePaceSecPerKm is number))
        && (!('best6kTimeSeconds' in data) || (data.best6kTimeSeconds is number))
        && (!('targetEquivalentSeconds' in data) || (data.targetEquivalentSeconds is number))
        && data.runType in ['Aerobic', 'Interval Training', '6K Time Trial', 'Time Trial', 'Tempo', 'Long Run', 'Race', 'Easy', 'Intervals', 'Recovery', 'Hill Repeats', 'Hill Run']
        && (!('slotId' in data) || (data.slotId is string && data.slotId.size() <= 32))
        && (!('avgHeartRate' in data) || (data.avgHeartRate is number))
        && (!('maxHeartRate' in data) || (data.maxHeartRate is number))
        && (!('avgCadence' in data) || (data.avgCadence is number))
        && (!('elevationGainMeters' in data) || (data.elevationGainMeters is number))
        && (!('source' in data) || (data.source is string && data.source.size() <= 64))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('garminActivityId' in data) || (data.garminActivityId is string && data.garminActivityId.size() <= 128))
        && (!('targetIntervalPaceSecPerKm' in data) || (data.targetIntervalPaceSecPerKm is number))
        && (!('activeIntervalPaceSecPerKm' in data) || (data.activeIntervalPaceSecPerKm is number))
        && (!('repCount' in data) || (data.repCount is number))
        && (!('repDistanceMeters' in data) || (data.repDistanceMeters is number))
        && (!('restDurationSeconds' in data) || (data.restDurationSeconds is number))
        && (!('totalRestSeconds' in data) || (data.totalRestSeconds is number))
        && (!('intervalDetails' in data) || (data.intervalDetails is map))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidAppAnnouncement(data) {
      return data.keys().hasAll(['id', 'enabled', 'title', 'message', 'severity', 'updatedAt'])
        && data.keys().hasOnly(['id', 'enabled', 'title', 'message', 'severity', 'updatedAt', 'updatedBy'])
        && data.id == 'announcement'
        && data.enabled is bool
        && data.title is string && data.title.size() <= 120
        && data.message is string && data.message.size() <= 500
        && data.severity in ['info', 'warning', 'success']
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 256));
    }

    function isValidAdminLog(data) {
      return data.keys().hasAll(['id', 'adminUid', 'adminEmail', 'action', 'details', 'createdAt'])
        && data.keys().hasOnly(['id', 'adminUid', 'adminEmail', 'action', 'targetId', 'targetLabel', 'details', 'createdAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.adminUid is string && data.adminUid == request.auth.uid
        && data.adminEmail is string && data.adminEmail.size() <= 256
        && data.action in [
          'delete_user',
          'suspend_user',
          'restore_user',
          'edit_user',
          'reset_user_runs',
          'reset_onboarding',
          'add_run',
          'edit_run',
          'delete_run',
          'purge_orphan_runs',
          'update_announcement',
          'change_pin'
        ]
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128))
        && (!('targetLabel' in data) || (data.targetLabel is string && data.targetLabel.size() <= 256))
        && data.details is string && data.details.size() <= 500
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // User Profile: /users/{userId}
    match /users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().id == userId
        && isValidUserProfile(incoming())
        && (!('accountStatus' in incoming()) || incoming().accountStatus == 'active')
        && !('suspensionReason' in incoming())
        && !('adminNotes' in incoming());
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == existing().id
        && (
          isAdmin()
          || (
            isSignedIn()
            && request.auth.uid == userId
            && (!('accountStatus' in existing()) || existing().accountStatus != 'suspended')
            && !incoming().diff(existing()).affectedKeys().hasAny(['accountStatus', 'suspensionReason', 'adminNotes'])
          )
        );
      allow delete: if isValidId(userId)
        && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
    }

    // Runs Collection: /runs/{runId}
    match /runs/{runId} {
      allow get: if isValidId(runId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(runId)
        && incoming().id == runId
        && isValidRunRecord(incoming())
        && (
          isAdmin()
          || (isSignedIn() && incoming().userId == request.auth.uid)
        );
      allow update: if isValidId(runId)
        && isValidRunRecord(incoming())
        && incoming().id == existing().id
        && (
          isAdmin()
          || (isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId)
        );
      allow delete: if isValidId(runId)
        && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
    }

    // Admin Passcode Config: /adminConfig/{userId}
    match /adminConfig/{userId} {
      allow get: if isAdmin() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().id == userId
        && isValidAdminConfig(incoming());
      allow update: if isAdmin()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().id == existing().id
        && isValidAdminConfig(incoming());
      allow delete: if false;
    }

    // Global App Announcement: /appConfig/announcement
    match /appConfig/{configId} {
      allow get: if isValidId(configId) && configId == 'announcement' && isSignedIn();
      allow list: if false;
      allow create, update: if isAdmin()
        && isValidId(configId)
        && configId == 'announcement'
        && isValidAppAnnouncement(incoming());
      allow delete: if isAdmin() && isValidId(configId) && configId == 'announcement';
    }

    // Admin Audit Logs: /adminLogs/{logId}
    match /adminLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(logId)
        && incoming().id == logId
        && isValidAdminLog(incoming());
      allow update: if false;
      allow delete: if isAdmin() && isValidId(logId);
    }
  }
}
