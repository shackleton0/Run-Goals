{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User runner profile and cross country 6k goals",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "targetDistanceKm": { "type": "number" },
        "targetGoalName": { "type": "string", "maxLength": 128 },
        "targetTimeSeconds": { "type": "number" },
        "targetPaceSecPerKm": { "type": "number" },
        "target6kTimeSeconds": { "type": "number" },
        "hasCustomTarget": { "type": "boolean" },
        "current6kPrSeconds": { "type": "number" },
        "weeklyRunGoal": { "type": "number" },
        "weeklyDistanceGoalKm": { "type": "number" },
        "unitPreference": { "type": "string", "enum": ["km", "miles"] },
        "athleteLevel": { "type": "string", "enum": ["Beginner", "High School XC", "Collegiate / Advanced", "Masters"] },
        "yraaDivision": {
          "type": "string",
          "enum": ["novice_women", "novice_men", "para_men", "junior_women", "junior_men", "senior_women", "senior_men"]
        },
        "maxHeartRate": { "type": "number" },
        "defaultIntervalPaceSecPerKm": { "type": "number" },
        "defaultRepDistanceMeters": { "type": "number" },
        "defaultRestDurationSeconds": { "type": "number" },
        "defaultRepCount": { "type": "number" },
        "goalTimeframeWeeks": { "type": "number" },
        "targetGoalDate": { "type": "string", "maxLength": 32 },
        "onboardingCompleted": { "type": "boolean" },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "suspensionReason": { "type": "string", "maxLength": 300 },
        "adminNotes": { "type": "string", "maxLength": 1000 },
        "directMessageTitle": { "type": "string", "maxLength": 120 },
        "directMessageBody": { "type": "string", "maxLength": 1000 },
        "directMessageSeverity": { "type": "string", "enum": ["info", "warning", "success"] },
        "directMessageSentAt": { "type": "string", "maxLength": 64 },
        "directMessageReadAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "weeklyRunGoal"]
    },
    "RunRecord": {
      "title": "RunRecord",
      "description": "Individual running activity record with Garmin metrics and 6k calculations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 150 },
        "distanceKm": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "averagePaceSecPerKm": { "type": "number" },
        "best6kTimeSeconds": { "type": "number" },
        "targetEquivalentSeconds": { "type": "number" },
        "runType": { "type": "string", "enum": ["Aerobic", "Interval Training", "6K Time Trial", "Time Trial", "Tempo", "Long Run", "Race", "Easy", "Intervals", "Recovery", "Hill Repeats", "Hill Run"] },
        "slotId": { "type": "string", "maxLength": 32 },
        "avgHeartRate": { "type": "number" },
        "maxHeartRate": { "type": "number" },
        "avgCadence": { "type": "number" },
        "elevationGainMeters": { "type": "number" },
        "source": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 1000 },
        "garminActivityId": { "type": "string", "maxLength": 128 },
        "targetIntervalPaceSecPerKm": { "type": "number" },
        "activeIntervalPaceSecPerKm": { "type": "number" },
        "repCount": { "type": "number" },
        "repDistanceMeters": { "type": "number" },
        "restDurationSeconds": { "type": "number" },
        "totalRestSeconds": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "date", "title", "distanceKm", "durationSeconds", "runType"]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Salted SHA-256 passcode configuration for the admin panel",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "pinHash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]+$" },
        "pinSalt": { "type": "string", "minLength": 16, "maxLength": 64 },
        "pinLength": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "pinHash", "pinSalt"]
    },
    "AppAnnouncement": {
      "title": "AppAnnouncement",
      "description": "Global coach or admin announcement banner displayed across user dashboards",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "enabled": { "type": "boolean" },
        "title": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "maxLength": 500 },
        "severity": { "type": "string", "enum": ["info", "warning", "success"] },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "enabled", "title", "message", "severity", "updatedAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable audit trail of admin actions performed in the Admin Console",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "adminUid": { "type": "string", "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 256 },
        "action": {
          "type": "string",
          "enum": [
            "delete_user",
            "suspend_user",
            "restore_user",
            "edit_user",
            "reset_user_runs",
            "reset_onboarding",
            "add_run",
            "edit_run",
            "delete_run",
            "purge_orphan_runs",
            "update_announcement",
            "send_user_message",
            "clear_user_message",
            "change_pin"
          ]
        },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetLabel": { "type": "string", "maxLength": 256 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "adminUid", "adminEmail", "action", "details", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Runner settings, 6K time target, and weekly 3-run goal configurations"
    },
    "/runs/{runId}": {
      "schema": "RunRecord",
      "description": "Cross country training runs, Garmin sync activities, and 6k trial performances"
    },
    "/adminConfig/{userId}": {
      "schema": "AdminConfig",
      "description": "Admin numeric passcode hash and salt restricted to the verified admin account"
    },
    "/appConfig/{configId}": {
      "schema": "AppAnnouncement",
      "description": "Global application announcement banner configured by admin"
    },
    "/adminLogs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Admin console action audit history"
    }
  }
}
